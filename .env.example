APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leadgen
REDIS_URL=redis://localhost:6379/0

TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=leadgen_session

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

MODEL_FILTER=openrouter/qwen/qwen3-8b
MODEL_SCORE=openrouter/deepseek/deepseek-chat-v3.1
MODEL_SUMMARY=openai/gpt-5-mini
MODEL_DIALOG=openai/gpt-5-mini
MODEL_HARD_DIALOG=openai/gpt-5

HOT_SCORE_THRESHOLD=85
HANDOFF_SCORE_THRESHOLD=90
MAX_CONTEXT_MESSAGES=12
MAX_FACTS_IN_PROMPT=6
MAX_REPLY_CHARS=420
HARD_TRIGGER_KEYWORDS=цена,бюджет,договор,кп,коммерческое,предоплата,гарантия,кейсы,риски,сроки,внедрение,интеграция

